# Copy to .env (git-ignored) only if you use the terminal collector (tools/collect-cli.mjs).
# The browser collector and the MCP servers need nothing here.
#
# Use your LOCAL address. A long-lived token is created in HA under Profile › Security.
# Better still: don't store the token at all — pass it from your password manager, e.g.
#   HA_TOKEN="$(op read 'op://Private/Home Assistant/token')" node tools/collect-cli.mjs
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
