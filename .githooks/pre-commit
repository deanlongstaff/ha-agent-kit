#!/bin/sh
# Blocks commits that contain secrets or personal data, or that break the export.
# Enabled by tools/setup.py (git config core.hooksPath .githooks). Works on Windows (Git's sh), macOS, Linux.
set -e
PY=""
for c in "$PYTHON" python3 python py; do
  [ -n "$c" ] || continue
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then PY="$c"; break; fi
done
[ -n "$PY" ] || { echo "pre-commit: Python 3.9+ not found (see tools/setup.py)"; exit 1; }
"$PY" tools/check_secrets.py --staged
"$PY" tools/validate.py
